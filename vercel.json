{
  "functions": {
    "api/private.js": {
      "includeFiles": "TABELAPHX.html"
    }
  },
  "routes": [
    {
      "src": "/py/?",
      "dest": "/api/private?token=py",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "/.*",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    }
  ]
}
