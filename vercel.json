{
  "functions": {
    "api/private.js": {
      "includeFiles": "TABELAPHX.html"
    },
    "api/catalog-sync.js": {
      "maxDuration": 20
    },
    "api/public-asset.js": {
      "includeFiles": "PAGINAS/**"
    }
  },
  "routes": [
    {
      "src": "/PAGINAS/(.*)",
      "dest": "/api/public-asset?file=$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/py/catalog\\.json/?",
      "dest": "/api/catalog-sync?token=py",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive",
        "Cache-Control": "private, no-store, max-age=0"
      }
    },
    {
      "src": "/py/?",
      "dest": "/api/private?token=py",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "/.*",
      "status": 404,
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    }
  ]
}
